rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isOfficer() {
      return isSignedIn() && userRole() == 'barangay_officer';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validRiskLevel(level) {
      return level in ['GREEN', 'YELLOW', 'ORANGE', 'RED'];
    }

    function validRole(role) {
      return role in ['user', 'admin', 'barangay_officer'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.fullName is string
        && request.resource.data.age is int
        && request.resource.data.age >= 0
        && request.resource.data.barangay is string
        && request.resource.data.municipality is string
        && validRiskLevel(request.resource.data.riskLevel)
        && validRole(request.resource.data.role);
      allow delete: if false;
    }

    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100;
      allow update, delete: if isAdmin();
    }

    match /symptoms/{symptomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt is string;
      allow update, delete: if isAdmin();
    }

    match /cleanup_tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOfficer();
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }

    match /{collection}/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
